# Copy to backend/.env and adjust. All settings are documented in README.md.
BEDROCK_AWS_PROFILE=default
BEDROCK_REGION=us-east-1
RERANK_REGION=us-west-2
CHAT_MODEL=us.anthropic.claude-sonnet-4-6
STATS_MODEL=us.anthropic.claude-sonnet-4-6
EMBED_MODEL=us.cohere.embed-v4:0

# Leave empty for embedded Qdrant + SQLite + local files under backend/data
QDRANT_URL=
DATABASE_URL=
STORAGE_BACKEND=local

# Production
# JWT_SECRET=<openssl rand -base64 48>
# COOKIE_SECURE=true
# ALLOW_REGISTRATION=false
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_KMS_KEY_ID=
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/pdfinsight
# QDRANT_URL=http://qdrant:6333
